<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <h2 class="all_users">All Users</h2>

    <div class="table_div">
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Username</th>
                    <th>e-mail</th>
                    <th colspan="2">Action</th>
                </tr>
            </thead>
            <tbody>
                <% for(user of users) { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td>
                        <form method="get" action="/user/<%= user.id %>/edit">
                            <button>Edit</button>
                        </form>
                    </td>
                    <td>
                        <form method="get" action="/user/<%= user.id %>/delete">
                            <button class="del">Delete</button>
                        </form>
                    </td>
                </tr>
                <% } %>
            </tbody>
        </table>
    </div>

</body>

</html>