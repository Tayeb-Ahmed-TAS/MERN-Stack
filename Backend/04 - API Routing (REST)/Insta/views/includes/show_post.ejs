    <section id="single_post" class="section-m1">
        <div class="container">
            <div class="single_box single_post_view">
                <div class="username">@<%=post.username%></div>
                <div class="post_id">Post Id: <span><%=post.id%></span></div>
                <div class="image">
                    <img src="<%=post.img%>" alt="" />
                </div>
                <div class="caption">
                    <p><%=post.caption%></p>
                </div>
            </div>
        </div>
    </section>