 <section class="posts section-m1">
     <div class="container">
         <div class="wrapper">
             <%for(let post of posts){%>
             <div class="single_box">
                 <div class="username">@<%=post.username%></div>
                 <div class="image">
                     <img src="<%=post.img%>" alt="" />
                 </div>
                 <div class="caption">
                     <p><%=post.caption%></p>
                 </div>
                 <div>
                     <form class="buttons" method="post" action="/ig/<%=post.id%>?_method=DELETE">
                         <a href="/ig/<%=post.id%>/edit"><i class="fa-regular fa-pencil"></i> Edit</a>
                         <button type="submit"><i class="fa-regular fa-trash-can"></i> Delete</button>
                         <a href="/ig/<%=post.id%>"><i class="fa-regular fa-eye"></i> View Details</a>
                     </form>
                 </div>
             </div>
             <%}%>
            </div>
        </div>
    </section>