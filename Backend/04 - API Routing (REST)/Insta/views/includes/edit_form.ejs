    <section id="create_post" class="section-m1">
        <div class="container">
            <div class="new_post_box">
                <h2>Edit Post</h2>

                <form method="post" action="/ig/<%= post.id %>?_method=PATCH">
                    <div>
                        Username: @<%= post.username %>
                    </div>
                    <div>
                        <label for="image_url">Image URL: </label>
                        <input type="text" id="image_url" name="img" value="<%= post.img %>" readonly />
                    </div>
                    <div>
                        <label for="caption_txt">Caption: </label>
                        <textarea name="caption" id="caption_txt"
                            placeholder="Write your caption here..."><%= post.caption %></textarea>
                    </div>

                    <div class="post_btn_div">
                        <button type="submit" class="btn">Update</button>
                    </div>
                </form>
            </div>
        </div>
    </section>