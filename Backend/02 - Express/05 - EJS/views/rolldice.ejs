<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roll Dice</title>
</head>

<body>
    <h1>Your Dice Value is: <%= diceVal %></h1>

    <% if(diceVal == 6) { %>
    <h2>Congratulations! You rolled a 6!</h2>
    <% } else { %>
    <h2>Try Again!</h2>
    <% } %>

    <a href="/">Home</a>

</body>

</html>