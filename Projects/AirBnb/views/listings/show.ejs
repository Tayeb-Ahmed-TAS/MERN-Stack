<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
</head>

<body>

    <h3>Listing Details : </h3>
    <ul>
        <li><%= listing.title %></li>
        <li><%= listing.description %></li>
        <li>&#2547; <%= listing.price.toLocaleString("en-BD") %></li>
        <!-- toLocaleString() converts number into string with comma and en-BD is for Bangladesh Standards -->
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
    </ul>
    <br>
    <a href="/listings/<%= listing._id %>/edit">Edit this Listing</a>
    <br>
    <br>
    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
        <button>Delete this listing</button>
    </form>
</body>

</html>