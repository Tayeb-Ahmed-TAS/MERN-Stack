<% layout("/layouts/boilerplate") -%>

<!-- Average Rating Calculation -->
<%
let avgRating = 0;

if (listing.reviews.length > 0) {
    let total = 0;

    for (const review of listing.reviews) {
        total += review.rating;
    }
    avgRating = total / listing.reviews.length;
}
%>

<div class="row mt-3 mb-3">
    <div class="col-8 offset-3">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card listing_card col-6 offset-3 show_card">
        <img src="<%= listing.image %>" class="card-img-top show_img" alt="listing_image">
        <div class="card-body">
            <div class="card-text">
                <div class="mt-3">
                    Owned by <i><%= listing.owner.username %></i>
                </div>
                <div class="mt-3">
                    <%= listing.description %>
                </div>
                <div class="mt-3">
                    <strong>&#2547; <%= listing.price.toLocaleString("en-BD") %></strong>
                </div>
                <div class="mt-3">
                    <i class="fa-solid fa-location-dot me-2"></i> <%= listing.location %>
                </div>
                <div class="mt-3">
                    <i class="fa-solid fa-earth-asia me-2"></i> <%= listing.country %>
                </div>
            </div>
        </div>
    </div>

    <br>

    <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
    <!-- Show Edit and Delete buttons only if the current user is available and is the owner of the listing -->
    <div class="btns">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark col-1 offset-3 edit_btn">Edit</a>

        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-dark offset-5">Delete</button>
        </form>
    </div>
    <% } %>


    <div class="col-8 offset-3 mb-3">
        <hr>
        <% if(currUser) { %>
        <!-- Show review form only if the current user is logged in -->
        <h4>Leave a Review</h4>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3 mt-3">
                <label class="form-label">Rating</label>
                <div class="star_rating">
                    <input type="hidden" name="review[rating]" id="rating" value="3" />
                    <i class="fa-solid fa-star star" data-value="1"></i>
                    <i class="fa-solid fa-star star" data-value="2"></i>
                    <i class="fa-solid fa-star star" data-value="3"></i>
                    <i class="fa-solid fa-star star" data-value="4"></i>
                    <i class="fa-solid fa-star star" data-value="5"></i>
                </div>
            </div>

            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                    required></textarea>
                <div class="invalid-feedback">Please provide a comment !</div>
            </div>

            <button class="btn btn-outline-dark">Submit</button>
        </form>

        <hr>
        <% } %>

        <p><b>All Reviews</b></p>
        <h4 class="avg_rate">
            <% if (listing.reviews.length > 0) { %>
            <%= avgRating.toFixed(1) %> <i class="fa-solid fa-star star"></i>
            <% } %>
        </h4>

        <div class="row mt-3">
            <% for(let review of listing.reviews ) { %>
            <div class="card col-5 ms-3 mb-3 p-3">
                <div class="card-body">
                    <h5>@<%= review.author.username %></h5>
                    <div class="star_rating_show">
                        <% for (let i = 1; i <= 5; i++) { %>
                        <i class="fa-solid fa-star stars <%= i <= review.rating ? 'active' : '' %>"></i>
                        <% } %>
                    </div>
                    <p class="card-text"><%= review.comment %></p>
                    <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                        <button class="btn btn-dark">Delete</button>
                    </form>
                </div>
            </div>
            <% } %>
        </div>
    </div>

</div>

<script src="/js/rating.js"></script>